{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "predev": "pnpm run build:sdk",
    "dev": "next dev -p 3000",
    "dev:webpack": "next dev -p 3000 --webpack",
    "build:sdk": "pnpm --dir ../../sdks/typescript install --frozen-lockfile && pnpm --dir ../../sdks/typescript run build",
    "build": "pnpm run build:sdk && next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "fbl": "pnpm install --frozen-lockfile && pnpm format && pnpm lint && pnpm build",
    "verify:chat-flatten": "tsx ../../scripts/verify_chat_flatten_contract.ts",
    "verify:stream-meta": "tsx ../../scripts/verify_stream_meta_validation_parity.ts",
    "verify:doc-snippets": "tsx scripts/verify-doc-snippets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "seal": "link:../../sdks/typescript",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vega": "6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
